{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS REST API",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "platform:role": "node dist/cli/platform-role.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@crm/contracts": "workspace:*",
    "@crm/db": "workspace:*",
    "@crm/permissions": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.4.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@crm/config": "workspace:*",
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
