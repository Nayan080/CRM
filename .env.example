# ─────────────────────────────────────────────────────────────
# Local development environment. Copy to `.env` (never commit `.env`).
#   PowerShell:  Copy-Item .env.example .env
# All values below are LOCAL-ONLY placeholders. Real environments get secrets
# from a secrets manager, never from files.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# API
API_PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (the web app)
CORS_ORIGINS=http://localhost:3000
# Web app base URL (used for links in emails)
WEB_APP_URL=http://localhost:3000
# Swagger UI at /api/docs — always forced OFF when NODE_ENV=production
SWAGGER_ENABLED=true
# Global rate limit (per client, per window) and stricter limit for auth endpoints
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Auth secrets — LOCAL DEV ONLY. Generate real ones with:  openssl rand -base64 48 / 32
JWT_ACCESS_SECRET=local-dev-only-change-me-local-dev-only-change-me
MFA_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHktbWZhLWtleS0zMi1ieXRlcyE=
# Refresh cookie "Secure" flag (true in production by default)
COOKIE_SECURE=false

# Email — Mailpit catches all mail locally: http://localhost:8025
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Migration CRM <no-reply@localhost>"

# Document storage — any S3-compatible store (DEC-15). Locally: S3Proxy from docker-compose.yml.
# These are also the defaults outside production, so they may be left out locally.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-2
S3_BUCKET=crm-documents-local
S3_ACCESS_KEY_ID=local-identity
S3_SECRET_ACCESS_KEY=local-credential
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

# Database (docker-compose.yml). Two users, least privilege:
#   crm_app = API runtime (no superuser → Row-Level Security applies)
#   crm     = migrations only (owner)
DATABASE_URL=postgresql://crm_app:crm_app_local_password@localhost:5432/crm
MIGRATION_DATABASE_URL=postgresql://crm:crm_local_password@localhost:5432/crm
# Integration tests use a separate database
TEST_DATABASE_URL=postgresql://crm_app:crm_app_local_password@localhost:5432/crm_test
TEST_MIGRATION_DATABASE_URL=postgresql://crm:crm_local_password@localhost:5432/crm_test
